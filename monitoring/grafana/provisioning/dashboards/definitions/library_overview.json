      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(library_http_requests_total)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Hiệu Năng Ứng Dụng & Database (App & DB Metrics)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "title": "Tần Suất Request Web App (Request Rate per second)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (status_code) (rate(library_http_requests_total[1m]))",
          "legendFormat": "Status {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "id": 5,
      "title": "Thời Gian Phản Hồi Trung Bình (Latency ms)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(library_http_request_duration_seconds_sum[1m]) / rate(library_http_request_duration_seconds_count[1m]) * 1000",
          "legendFormat": "Avg Latency (ms)",
          "refId": "A"
        }
      ]
    },
